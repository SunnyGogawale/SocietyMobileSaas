{
  "name": "society-management-saas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  },
  "packageManager": "npm@10.9.4",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev": "concurrently -k -n WEB,API -c green,blue \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "npm run dev --workspace @society/web",
    "dev:api": "npm run dev --workspace @society/api",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint apps packages",
    "test": "npm test --workspaces --if-present",
    "format": "prettier --config packages/config/prettier.config.cjs --write \"**/*.{js,jsx,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "oxlint": "^1.81.0",
    "prettier": "^3.5.3"
  }
}